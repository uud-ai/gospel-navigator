# Локальная разработка: скопировать в .env (gitignored), экспортировать перед
# локальным запуском index.js. В проде эти значения задаются как переменные
# окружения/секреты облачной функции (`yc serverless function version create
# --environment ... --secret ...`), НЕ через этот файл, не коммитятся.

# Должен совпадать с APP_TOKEN, зашитым в index.html.
APP_TOKEN=

# Ключ proxyapi.ru (OpenAI-совместимый прокси) — используется и для
# эмбеддингов запроса, и для самого ответа чата.
PROXY_API_KEY=

# Необязательно — модель чата, по умолчанию 'gpt-4o-mini'.
CHAT_MODEL=

# Необязательно — https-префикс для data/*.json и *_embeddings.bin,
# по умолчанию raw.githubusercontent.com на этот же репозиторий.
DATA_BASE_URL=

# Разрешённые Origin через запятую (CORS + проверка источника запроса).
# По умолчанию 'https://nikolskiyhram.site'. Добавьте домен GitHub Pages
# сайта через запятую, если фронтенд открывается и оттуда напрямую.
ALLOWED_ORIGINS=
