# Задаются в консоли Yandex Cloud (переменные окружения функции),
# НЕ храните реальные значения в этом файле и не коммитьте их.

# Должен совпадать с APP_TOKEN, зашитым в index.html.
APP_TOKEN=

# Ключ proxyapi.ru (OpenAI-совместимый прокси) — используется и для
# эмбеддингов запроса, и для самого ответа чата.
PROXY_API_KEY=

# Необязательно: модель чата, по умолчанию gpt-4o-mini.
CHAT_MODEL=

# https-префикс, откуда function.js читает data/bible.json,
# data/commentaries.json и *_embeddings.json. Объекты должны быть
# доступны на чтение без авторизации (например, публичный бакет
# Yandex Object Storage).
# Пример: https://storage.yandexcloud.net/<bucket>
DATA_BASE_URL=
