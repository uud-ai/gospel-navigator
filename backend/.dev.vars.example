# Локальная разработка: скопировать в .dev.vars (gitignored) для `wrangler dev`.
# В продакшене эти значения задаются через `wrangler secret put <ИМЯ>`,
# НЕ через этот файл и не через wrangler.toml — не коммитьте реальные значения.

# Должен совпадать с APP_TOKEN, зашитым в index.html.
APP_TOKEN=

# Ключ proxyapi.ru (OpenAI-совместимый прокси) — используется и для
# эмбеддингов запроса, и для самого ответа чата.
PROXY_API_KEY=
